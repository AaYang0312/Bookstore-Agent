# 模型
MODEL_NAME=Openai
MODEL_BASE_URL=https://
MODEL_API_KEY=sk-xxx

# 网络
BOOKSTORE_API_BASE_URL=http://localhost:8080/api/v1
BOOKSTORE_ADMIN_BASE_URL=http://localhost:8080/admin
TAVILY_API_KEY=tvly-xxx

# ---- 以下均为可选：不配置时 RAG/记忆/个性化自动降级，原有三工具行为不变 ----

# Milvus（docker compose 起的 standalone，宿主机访问地址）
MILVUS_URI=http://localhost:19530
# MILVUS_COLLECTION_PREFIX=books

# Embedding（OpenAI 兼容接口；不配置 EMBEDDING_* 时 semantic_search_books 不注册）
EMBEDDING_MODEL_NAME=text-embedding-3-small
# EMBEDDING_BASE_URL=https://api.openai.com/v1   # 默认复用 MODEL_BASE_URL
# EMBEDDING_API_KEY=sk-xxx                        # 默认复用 MODEL_API_KEY
EMBEDDING_DIM=1024

# RAG 检索
# RAG_RECALL_K=20
# RAG_TOP_K=5

# Rerank 重排（可选，默认关闭）
# RERANK_ENABLED=false
# RERANK_BASE_URL=https://
# RERANK_API_KEY=sk-xxx
# RERANK_MODEL=bge-reranker-v2-m3

# Redis（服务端会话记忆 / 画像缓存 / 入库水位；不配置时降级为前端传 history）
REDIS_URL=redis://localhost:6379/0

# 入库管道
# INGEST_PAGE_SIZE=100
# INGEST_SCHEDULE_ENABLED=false
# INGEST_SCHEDULE_INTERVAL_MINUTES=60
# Go 内部只读同步接口（GET /internal/books/sync）的共享密钥，需与后端 BOOKSTORE_INTERNAL_SYNC_SECRET 一致
INTERNAL_SYNC_SECRET=change-me-internal-secret
